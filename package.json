{
  "name": "cashlet-wallet",
  "version": "0.1.1",
  "private": true,
  "description": "Cashlet: a self-custodial Bitcoin Cash wallet for the browser, with CashTokens, Nostr signing and BND identity",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cashlet-labs/cashlet-wallet.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/check-build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@cashlet-labs/bnd": "0.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@wizardconnect/core": "0.2.11",
    "@wizardconnect/wallet": "0.2.5",
    "idb": "8.0.4",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.0.320",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  }
}
